{
  "@@locale": "en",
  "appTitle": "{{{display_name_json}}}",
  "@appTitle": {
    "description": "The application title shown in the OS task switcher."
  },
  "plan": "Subscription",
  "@plan": {
    "description": "Settings section for the money rail. Upgrade and Manage sit side by side so cancelling is never buried deeper than subscribing (ROSCA)."
  },
  "paywallGateMessage": "This part of the app is included with a subscription.",
  "@paywallGateMessage": {
    "description": "Shown in place of a gated surface. States a fact, never a countdown or a discount — the chassis knows neither."
  },
  "managePlanTitle": "Manage subscription",
  "@managePlanTitle": {
    "description": "App-bar title of the manage screen, and the settings entry that opens it."
  },
  "planActive": "Your subscription is active",
  "@planActive": {
    "description": "Reflects the SERVER's entitlement answer, not a local flag."
  },
  "planInactive": "You do not have an active subscription",
  "@planInactive": {
    "description": "See subscriptionActive."
  },
  "restorePurchasesHint": "Signed in on a new device? This re-checks your subscription.",
  "@restorePurchasesHint": {
    "description": "Explains what the control does in terms of the user's situation rather than the mechanism."
  },
  "cancelPlan": "Cancel subscription",
  "@cancelPlan": {
    "description": "Starts the cancellation. One tap from Manage, which is one tap from Settings — the same depth as Upgrade (ROSCA)."
  },
  "cancelPlanConfirm": "This will end your subscription. You can subscribe again at any time.",
  "@cancelPlanConfirm": {
    "description": "The confirmation body. States what happens and that it is reversible; makes no retention offer, because a cancel flow that bargains is the pattern ROSCA exists to stop."
  },
  "cancelExecuted": "Your subscription has been cancelled.",
  "@cancelExecuted": {
    "description": "Said ONLY when the merchant of record confirms. Distinct from cancelRecorded on purpose."
  },
  "cancelNoPlan": "There is no active subscription on this account.",
  "@cancelNoPlan": {
    "description": "The server found nothing to cancel."
  },
  "cancelFailed": "We could not cancel your subscription. Nothing has changed — please try again.",
  "@cancelFailed": {
    "description": "States plainly that nothing changed. A cancellation that silently did not happen is the worst outcome this screen has, and it must never be reported as success."
  }
}
